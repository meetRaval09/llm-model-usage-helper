{
  "manifest_version": 3,
  "name": "Memory Layer",
  "version": "0.1.0",
  "description": "Save your AI chats to your own local memory.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"]
    }
  ]
}
